# Required for real AI investigations. Without it the app runs in clearly-labelled Demo mode.
ANTHROPIC_API_KEY=

# Model per step (optional). Defaults shown.
# Per-document extraction: simple, high-volume work, so a cheap model.
# ANTHROPIC_EXTRACTION_MODEL=claude-haiku-5-5
# Cross-document reasoning: the hard part that determines report quality.
# Set to claude-sonnet-5-5 to roughly halve this step's cost (test quality first).
# ANTHROPIC_REASONING_MODEL=claude-opus-5-5
# Report part 2 (work status + recovery plan). Follows the reasoning model unless set.
# ANTHROPIC_PLANNING_MODEL=claude-sonnet-5-5
# Effort for both report calls: low | medium | high (default high). Lower = less thinking, cheaper.
# ANTHROPIC_REASONING_EFFORT=medium

# LLM_PROVIDER=anthropic   # or "demo" to force demo mode

# OCR of scanned PDF pages runs locally (Tesseract). Set to false to turn it off.
# OCR_ENABLED=true
