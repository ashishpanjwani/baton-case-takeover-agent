# Required for real AI investigations. Without it the app runs in clearly-labelled Demo mode.
ANTHROPIC_API_KEY=

# How the investigation runs (optional):
#   agent    (default) the AI runs the investigation with tools: it chooses what to read,
#            searches the file to follow leads, checks its own quotes, and builds the report.
#   workflow the earlier fixed sequence of steps.
# INVESTIGATION_METHOD=agent
# Upper limit on the agent's steps (model turns). Bounds the time and cost of a run.
# AGENT_MAX_TURNS=60

# Models (optional). Defaults shown.
# The investigating agent, and report part 1 in the workflow. Determines report quality.
# Set to claude-sonnet-5-5 or claude-haiku-5-5 to cut cost (test quality first).
# ANTHROPIC_REASONING_MODEL=claude-opus-5-5
# Workflow only: per-document notes, and report part 2.
# ANTHROPIC_EXTRACTION_MODEL=claude-haiku-5-5
# ANTHROPIC_PLANNING_MODEL=claude-sonnet-5-5
# Effort: low | medium | high. Lower = less thinking, cheaper.
# (The agent uses medium unless set; the workflow's report calls use high.)
# ANTHROPIC_REASONING_EFFORT=medium

# LLM_PROVIDER=anthropic   # or "demo" to force demo mode

# OCR of scanned PDF pages runs locally (Tesseract). Set to false to turn it off.
# OCR_ENABLED=true
